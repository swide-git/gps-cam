<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: trips and settings stay on this device (allowBackup=false
     covers Android 11 and below; this file is the Android 12+ equivalent). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
